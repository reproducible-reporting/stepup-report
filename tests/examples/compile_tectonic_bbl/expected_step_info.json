    "STEPUP_REPORT_TECTONIC_ARGS",
    "STEPUP_REPORT_TECTONIC_KEEP_DEPS"
  ],
  "out": [
    "paper.pdf"
  ],
  "vol": [],
  "workdir": "."
}
